{#
/**
 * @file
 * Default theme implementation for the weather widget.
 *
 * Available variables:
 * - current: Current weather data (temperature, wind, waves, sea temp).
 * - forecast: Array of daily forecasts (5 days).
 * - fetched: Unix timestamp when the data was fetched.
 *
 * @see template_preprocess_openmeteo_weather_widget()
 *
 * @ingroup themeable
 */
#}
{% macro icon(kind) %}
{%- if kind == 'sun' -%}
<svg class="omw-icon-svg omw-i-sun" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><circle cx="12" cy="12" r="4.2"/><g stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><line x1="12" y1="2.5" x2="12" y2="5"/><line x1="12" y1="19" x2="12" y2="21.5"/><line x1="2.5" y1="12" x2="5" y2="12"/><line x1="19" y1="12" x2="21.5" y2="12"/><line x1="5.1" y1="5.1" x2="6.9" y2="6.9"/><line x1="17.1" y1="17.1" x2="18.9" y2="18.9"/><line x1="18.9" y1="5.1" x2="17.1" y2="6.9"/><line x1="6.9" y1="17.1" x2="5.1" y2="18.9"/></g></svg>
{%- elseif kind == 'partly' -%}
<svg class="omw-icon-svg omw-i-partly" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><circle cx="8.5" cy="7.5" r="3.4" fill="currentColor"/><g stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><line x1="8.5" y1="1.6" x2="8.5" y2="3.2"/><line x1="8.5" y1="11.8" x2="8.5" y2="13.4"/><line x1="2.6" y1="7.5" x2="4.2" y2="7.5"/><line x1="12.8" y1="7.5" x2="14.4" y2="7.5"/><line x1="4.3" y1="3.3" x2="5.4" y2="4.4"/><line x1="11.6" y1="10.6" x2="12.7" y2="11.7"/></g><path transform="translate(6 8)" d="M4 13a5 5 0 0 1 .5-9.97 5.5 5.5 0 0 1 10.4 1.9A4.2 4.2 0 0 1 14.5 13z" fill="currentColor"/></svg>
{%- elseif kind == 'cloud' -%}
<svg class="omw-icon-svg omw-i-cloud" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M7 18a5 5 0 0 1 .5-9.97 5.5 5.5 0 0 1 10.4 1.9A4.2 4.2 0 0 1 17.5 18z" fill="currentColor"/></svg>
{%- elseif kind == 'fog' -%}
<svg class="omw-icon-svg omw-i-fog" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M7 14a4.6 4.6 0 0 1 .45-9.17 5 5 0 0 1 9.5 1.8A3.8 3.8 0 0 1 16.8 14z" fill="currentColor"/><g stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><line x1="4" y1="17.4" x2="20" y2="17.4"/><line x1="6" y1="20.4" x2="18" y2="20.4"/></g></svg>
{%- elseif kind == 'drizzle' -%}
<svg class="omw-icon-svg omw-i-drizzle" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M7 12a4.6 4.6 0 0 1 .45-9.17 5 5 0 0 1 9.5 1.8A3.8 3.8 0 0 1 16.8 12z" fill="currentColor"/><g stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><line x1="8" y1="15.5" x2="7.2" y2="17.6"/><line x1="12" y1="15.5" x2="11.2" y2="17.6"/><line x1="16" y1="15.5" x2="15.2" y2="17.6"/></g></svg>
{%- elseif kind == 'rain' -%}
<svg class="omw-icon-svg omw-i-rain" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M7 12a4.6 4.6 0 0 1 .45-9.17 5 5 0 0 1 9.5 1.8A3.8 3.8 0 0 1 16.8 12z" fill="currentColor"/><g stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><line x1="7.5" y1="15.5" x2="6.3" y2="18.5"/><line x1="11.5" y1="15.5" x2="10.3" y2="18.5"/><line x1="15.5" y1="15.5" x2="14.3" y2="18.5"/></g></svg>
{%- elseif kind == 'snow' -%}
<svg class="omw-icon-svg omw-i-snow" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M7 12a4.6 4.6 0 0 1 .45-9.17 5 5 0 0 1 9.5 1.8A3.8 3.8 0 0 1 16.8 12z" fill="currentColor"/><g stroke="currentColor" stroke-width="1.4" stroke-linecap="round"><line x1="8" y1="16" x2="6.5" y2="17.8"/><line x1="10" y1="16" x2="8.5" y2="17.8"/><line x1="12" y1="16" x2="10.5" y2="17.8"/><line x1="14" y1="16" x2="12.5" y2="17.8"/></g></svg>
{%- else -%}
<svg class="omw-icon-svg omw-i-storm" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M7 12a4.6 4.6 0 0 1 .45-9.17 5 5 0 0 1 9.5 1.8A3.8 3.8 0 0 1 16.8 12z" fill="currentColor"/><path d="M12.6 13.4l-2.2 3.6h2.4L11 21l5-6h-2.6l.8-1.6z" fill="currentColor" stroke="currentColor" stroke-width=".5"/></svg>
{%- endif -%}
{% endmacro %}
{% import _self as macros %}

<div class="omw">
  <div class="omw-now">
    <div class="omw-now-primary">
      <span class="omw-big-icon">{{ macros.icon(current.icon|default('cloud')) }}</span>
      <div class="omw-now-text">
        <div class="omw-temp">{{ current.temperature ? current.temperature|round : '–' }}&deg;<span class="omw-unit">C</span></div>
        <div class="omw-desc">{{ current.desc }}</div>
      </div>
    </div>

    <div class="omw-grid">
      <div class="omw-cell">
        <span class="omw-label">{{ 'Wind'|t }}</span>
        <span class="omw-value">{{ current.wind_speed ? current.wind_speed|round : '–' }} m/s</span>
        {% if current.wind_direction is not null %}
          <span class="omw-compass" style="--rot: {{ current.wind_direction }}deg"><i></i>{{ current.wind_compass }}</span>
        {% endif %}
      </div>
      <div class="omw-cell">
        <span class="omw-label">{{ 'Waves'|t }}</span>
        <span class="omw-value">{{ current.wave_height ? current.wave_height|round(1) : '–' }} m
          {%- if current.wave_period %} · {{ current.wave_period|round(0) }} s{% endif -%}
        </span>
        {% if current.wave_direction is not null %}
          <span class="omw-compass omw-compass-wave" style="--rot: {{ current.wave_direction }}deg"><i></i>{{ current.wave_compass }}</span>
        {% endif %}
      </div>
      <div class="omw-cell">
        <span class="omw-label">{{ 'Sea temperature'|t }}</span>
        <span class="omw-value">{{ current.sea_temp is not null ? current.sea_temp|round(1) : '–' }}&deg; C</span>
      </div>
      <div class="omw-cell">
        <span class="omw-label">{{ 'Precipitation'|t }}</span>
        <span class="omw-value">{{ current.precipitation ? current.precipitation|round(1) : '0' }} mm</span>
      </div>
    </div>

    <div class="omw-updated">{{ 'Updated'|t }} {{ fetched|date('d.m.Y · H:i') }}</div>
  </div>

  {% if forecast %}
  <div class="omw-forecast">
    {% for day in forecast %}
      <div class="omw-day{{ loop.first ? ' omw-day-today' }}">
        <div class="omw-day-name">{{ day.name }}<span class="omw-day-date">{{ day.date_display }}</span></div>
        <div class="omw-day-icon">{{ macros.icon(day.icon|default('cloud')) }}</div>
        <div class="omw-day-temps">
          <span class="omw-day-max">{{ day.temp_max ? day.temp_max|round : '–' }}&deg;</span>
          <span class="omw-day-min">{{ day.temp_min ? day.temp_min|round : '–' }}&deg;</span>
        </div>
        <div class="omw-day-detail"><span class="omw-k k-wind" title="{{ 'Wind'|t }}">{{ day.wind_max ? day.wind_max|round : '–' }}</span><span class="omw-k-unit">m/s</span>{% if day.wind_compass %}<span class="omw-mini-compass" title="{{ 'Wind direction'|t }}">{{ day.wind_compass }}</span>{% endif %}</div>
        {% if day.wave_max is not null %}
          <div class="omw-day-detail omw-day-wave"><span title="{{ 'Wave'|t }} {{ day.wave_max|round(1) }} m">« {{ day.wave_max|round(1) }} m{% if day.wave_period_max %} · {{ day.wave_period_max|round(0) }} s{% endif %} »</span>{% if day.wave_compass %}<span class="omw-mini-compass omw-mini-wave" title="{{ 'Wave direction'|t }}">{{ day.wave_compass }}</span>{% endif %}</div>
        {% endif %}
      </div>
    {% endfor %}
  </div>
  {% endif %}

  <div class="omw-foot">{{ 'Weather & waves from Open-Meteo (DWD/ECMWF · Marine)'|t }}</div>
</div>