{#
/**
 * @file
 * Default theme implementation for the weather widget.
 *
 * Available variables:
 * - current: Current weather data (temperature, wind, waves, sea temp).
 * - forecast: Array of daily forecasts (5 days).
 * - fetched: Unix timestamp when the data was fetched.
 *
 * @see template_preprocess_openmeteo_weather_widget()
 *
 * @ingroup themeable
 */
#}
{% macro icon(kind) %}
{%- set classes = {
  'sun': 'wi wi-day-sunny',
  'partly': 'wi wi-day-cloudy',
  'cloud': 'wi wi-cloudy',
  'fog': 'wi wi-fog',
  'drizzle': 'wi wi-sprinkle',
  'rain': 'wi wi-rain',
  'snow': 'wi wi-snow',
  'storm': 'wi wi-thunderstorm',
} -%}
<i class="{{ classes[kind]|default('wi wi-cloudy') }} omw-icon-wi omw-wi-{{ kind|default('cloud') }}" aria-hidden="true"></i>
{% endmacro %}
{% import _self as macros %}

<div class="omw">
  <div class="omw-now">
    <div class="omw-now-primary">
      <span class="omw-big-icon">{{ macros.icon(current.icon|default('cloud')) }}</span>
      <div class="omw-now-text">
        <div class="omw-temp">{{ current.temperature ? current.temperature|round : '–' }}&deg;<span class="omw-unit">C</span></div>
        <div class="omw-desc">{{ current.desc }}</div>
      </div>
    </div>

    <div class="omw-grid">
      <div class="omw-cell">
        <span class="omw-label">{{ 'Wind'|t }}</span>
        <span class="omw-value">{{ current.wind_speed ? current.wind_speed|round : '–' }} m/s</span>
        {% if current.wind_direction is not null %}
          <span class="omw-compass" style="--rot: {{ current.wind_direction }}deg"><i></i>{{ current.wind_compass }}</span>
        {% endif %}
      </div>
      <div class="omw-cell">
        <span class="omw-label">{{ 'Waves'|t }}</span>
        <span class="omw-value">{{ current.wave_height ? current.wave_height|round(1) : '–' }} m
          {%- if current.wave_period %} · {{ current.wave_period|round(0) }} s{% endif -%}
        </span>
        {% if current.wave_direction is not null %}
          <span class="omw-compass omw-compass-wave" style="--rot: {{ current.wave_direction }}deg"><i></i>{{ current.wave_compass }}</span>
        {% endif %}
      </div>
      <div class="omw-cell">
        <span class="omw-label">{{ 'Sea temperature'|t }}</span>
        <span class="omw-value">{{ current.sea_temp is not null ? current.sea_temp|round(1) : '–' }}&deg; C</span>
      </div>
      <div class="omw-cell">
        <span class="omw-label">{{ 'Precipitation'|t }}</span>
        <span class="omw-value">{{ current.precipitation ? current.precipitation|round(1) : '0' }} mm</span>
      </div>
    </div>

    <div class="omw-updated">{{ 'Updated'|t }} {{ fetched|date('d.m.Y · H:i') }}</div>
  </div>

  {% if forecast %}
  <div class="omw-forecast">
    {% for day in forecast %}
      <div class="omw-day{{ loop.first ? ' omw-day-today' }}">
        <div class="omw-day-name">{{ day.name }}<span class="omw-day-date">{{ day.date_display }}</span></div>
        <div class="omw-day-icon">{{ macros.icon(day.icon|default('cloud')) }}</div>
        <div class="omw-day-temps">
          <span class="omw-day-max">{{ day.temp_max ? day.temp_max|round : '–' }}&deg;</span>
          <span class="omw-day-min">{{ day.temp_min ? day.temp_min|round : '–' }}&deg;</span>
        </div>
        <div class="omw-day-detail"><span class="omw-k k-wind" title="{{ 'Wind'|t }}">{{ day.wind_max ? day.wind_max|round : '–' }}</span><span class="omw-k-unit">m/s</span>{% if day.wind_compass %}<span class="omw-mini-compass" title="{{ 'Wind direction'|t }}">{{ day.wind_compass }}</span>{% endif %}</div>
        {% if day.wave_max is not null %}
          <div class="omw-day-detail omw-day-wave"><span title="{{ 'Wave'|t }} {{ day.wave_max|round(1) }} m">« {{ day.wave_max|round(1) }} m{% if day.wave_period_max %} · {{ day.wave_period_max|round(0) }} s{% endif %} »</span>{% if day.wave_compass %}<span class="omw-mini-compass omw-mini-wave" title="{{ 'Wave direction'|t }}">{{ day.wave_compass }}</span>{% endif %}</div>
        {% endif %}
      </div>
    {% endfor %}
  </div>
  {% endif %}

  <div class="omw-foot">{{ source_text|default('Weather & waves from Open-Meteo (DWD/ECMWF · Marine)'|t) }}{% if is_stale %} · <span class="omw-stale">{{ 'stale data'|t }}</span>{% endif %}</div>
</div>